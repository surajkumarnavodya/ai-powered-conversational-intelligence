# Copy this file to .env and fill in your real database connection details.
# .env is gitignored -- never commit real credentials.

# --- Ollama (local LLM) ---
# Where the model *files* live is an Ollama setting, not an app setting:
# set the OLLAMA_MODELS environment variable (Windows: user-level, since
# Ollama here runs as a desktop app rather than a service) before starting
# Ollama, e.g. D:\OllamaModels to keep multi-GB weights off the system
# drive. This app never reads that variable -- it only talks to the HTTP
# API below -- but the drive you point it at needs the space.
# See docs/CONFIGURATION.md's "Where Ollama stores model files" section.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# --- Ollama model selection (optional) ---
# Lets a caller/the dashboard pick which locally-installed Ollama model
# answers a given question (AskRequest.model / GET /models), instead of
# always using OLLAMA_MODEL above. Off (well, harmless) by default: leaving
# both of these unset still gives a small, practical starter set of models
# to choose from (see config/ollama_models.yaml) -- OLLAMA_MODEL above is
# always included and remains the default when a caller picks nothing.
# Set OLLAMA_MODEL_SELECTION_ENABLED=false to hard-disable the feature
# (every request then uses OLLAMA_MODEL, same as before this existed).
# OLLAMA_ALLOWED_MODELS is a comma-separated list of additional model names
# this app will ever offer -- each one must still be pulled locally
# (`ollama pull <model>`) before it can actually be selected; an allowed-
# but-not-installed model shows as "Not installed" in the UI rather than
# being hidden. See docs/CONFIGURATION.md's "Model selection" section.
# OLLAMA_MODEL_SELECTION_ENABLED=true
# OLLAMA_ALLOWED_MODELS=qwen2.5-coder:7b,qwen2.5:7b,qwen2.5:14b,llama3.2:3b,mistral:7b,deepseek-r1:8b

# --- Per-task model pins (model_routing/tasks.py) ---
# Which model each KIND of LLM work starts from. Blank (the default for
# every one) means "use OLLAMA_MODEL", so a deployment that sets none of
# these behaves exactly as it did before they existed.
#
# These are baselines, not overrides: a caller-supplied AskRequest.model
# still wins, and governed model routing below may still escalate or
# de-escalate from the baseline when ENABLE_MODEL_ROUTING=true.
#
# Every non-blank value is checked against OLLAMA_ALLOWED_MODELS at
# startup and the app REFUSES TO BOOT on a pin outside it. An unapproved
# pin is not a degraded experience -- it is a model the operator never
# approved receiving this deployment's prompts and retrieved data.
#
# Source/intent classification. Wants a small, fast model: the output is
# a few tokens and the call sits directly in the user's latency path.
ROUTER_MODEL=
# SQL generation -- the one task where a SQL-specialised model
# (sqlcoder, duckdb-nsql) can beat a larger general model.
SQL_MODEL=
# Answer composition over retrieved chunks. Wants instruction-following
# and faithfulness to the excerpts, not SQL ability.
RAG_ANSWER_MODEL=
# Image understanding. This is MEDIA_VISION_MODEL, which already owns
# that choice -- set it there rather than here, so there is one owner.
# VISION_MODEL -> see MEDIA_VISION_MODEL below.
# Text embedding. This is EMBEDDING_MODEL_NAME, which already owns that
# choice (a sentence-transformers model, not an Ollama chat model, which
# is why it is not allowlist-checked against OLLAMA_ALLOWED_MODELS).
# EMBEDDING_MODEL -> see EMBEDDING_MODEL_NAME below.
# The approved alternate used when a task has no pin of its own.
# Distinct from governed routing's runtime fallback chain, which handles
# a model that is DOWN rather than one that is unconfigured.
FALLBACK_MODEL=
# How governed routing orders otherwise-equally-eligible candidates:
#   capability | cost | latency | quality
# "capability" is the pre-existing behaviour and the default, so this
# changes nothing until an operator sets it. A strategy only ever chooses
# between models that are ALREADY eligible -- it can never reach a model
# outside OLLAMA_ALLOWED_MODELS, relax a task's risk level, or widen a
# budget. A strategy is a preference, never a permission.
MODEL_ROUTING_STRATEGY=capability

# --- Governed model routing (see model_routing/, api/model_routing.py) ---
# Picks which locally-installed Ollama model drafts each LLM call the SQL
# pipeline makes, by complexity, risk, latency and capability -- a smaller
# model for simple work, a stronger one for complex reasoning. OFF by
# default: unlike the pure-computation analytics engines, this changes
# which model answers a real question. With it off, every call in a run
# uses one model (OLLAMA_MODEL, or the caller's own AskRequest.model),
# exactly as before. A caller's explicit model choice always wins over
# routing. Routing never validates SQL, checks a permission or resolves a
# tenant -- see model_routing/__init__.py.
# ENABLE_MODEL_ROUTING=false
# A model is only ever chosen *over* OLLAMA_MODEL when an approved/deployed
# `model`-typed governed asset version exists for it with recorded
# evaluation results (the AI Governance Center, /governance). Applies to
# downgrades too. Leave on unless you want routing on tier/capability
# metadata alone (config/ollama_models.yaml).
# MODEL_ROUTING_REQUIRE_EVALUATION_EVIDENCE=true
# Complexity score (count of agent/complexity.py signals, plus one each for
# a planning-implying intent and an ambiguous one) at or above which
# routing may escalate, and at or below which a low-risk task
# (analytical_intent, sql_insight) may use a smaller model. Downgrade must
# be strictly less than upgrade.
# MODEL_ROUTING_UPGRADE_COMPLEXITY_THRESHOLD=2
# MODEL_ROUTING_DOWNGRADE_COMPLEXITY_THRESHOLD=0
# A model this deployment has actually measured as slower than this at p95
# is dropped from the escalation set. A model with no measurement yet is
# never blocked by it.
# MODEL_ROUTING_MAX_P95_LATENCY_MS=30000.0
# Alternative models one decision may try if the chosen one turns out to be
# unavailable. 0 disables fallback.
# MODEL_ROUTING_MAX_FALLBACKS=2
# Per-request ceilings. Cost units are ordinal compute units (small=1,
# medium=2, large=5), NOT money -- every model runs locally. A spent budget
# removes the option to escalate; the request still gets its answer on
# OLLAMA_MODEL.
# MODEL_ROUTING_MAX_LLM_CALLS_PER_REQUEST=40
# MODEL_ROUTING_MAX_COST_UNITS_PER_REQUEST=60
# Per-tenant hourly cap on escalations (not on questions -- those are
# already metered by the /ask rate and concurrency limits).
# MODEL_ROUTING_ESCALATIONS_PER_HOUR=500
# Per-model circuit breaker: consecutive *availability* failures before a
# model is skipped, and how long before one probe is allowed through. A
# malformed answer is a quality failure and deliberately never trips this.
# MODEL_ROUTING_BREAKER_FAILURE_THRESHOLD=3
# MODEL_ROUTING_BREAKER_COOLDOWN_SECONDS=60.0
# How long a tenant's governed model-evaluation evidence is cached on the
# request path.
# MODEL_ROUTING_EVIDENCE_TTL_SECONDS=300.0

# --- Proactive KPI monitoring (see kpi_monitoring/, api/kpi_monitoring.py) ---
# Watches governed catalog metrics for meaningful movement, investigates
# it, suppresses repeats and ranks what is left by impact. ON by default:
# a pure, deterministic computation over data the caller already fetched
# -- it never queries a database, never calls an LLM, and does nothing at
# all until a policy is configured and a scan is requested.
# ENABLE_KPI_MONITORING=true
# Default "meaningful change" floor (percent) for a policy that does not
# set its own. The primary noise control and the first thing to tune.
# KPI_MONITOR_MIN_CHANGE_PERCENT=10.0
# Work/payload caps. A policy beyond the policy cap is reported as a
# `too_many_policies` violation, never silently dropped; findings beyond
# the findings cap are dropped lowest-ranked-first with `truncated` set.
# KPI_MONITOR_MAX_POLICIES_PER_SCAN=50
# KPI_MONITOR_MAX_POINTS_PER_METRIC=500
# KPI_MONITOR_MAX_FINDINGS_PER_SCAN=200

# --- Data privacy, domain safety & governance (see governance/) ---
# The centralized engine every request passes through: what may be asked,
# what may be returned, what may be recommended. See
# docs/DATA_PRIVACY_GOVERNANCE_ENGINE.md for the full audit report.
# Each layer has its own independent rollback switch; all default ON
# because every layer is deterministic and adds no LLM call.
# ENABLE_REQUEST_GOVERNANCE=true
# ENABLE_RESULT_GOVERNANCE=true
# ENABLE_RECOMMENDATION_SAFETY=true
# The default k-anonymity threshold for a grouped result carrying
# individual-level sensitive measures. A domain declaring its own
# minimum_group_size overrides this; a domain declaring 0 opts out
# because it has no individuals to protect (e.g. manufacturing
# throughput). Small-group suppression applies even to an authorized
# caller -- it protects the individual in the group, not the column.
# GOVERNANCE_MIN_GROUP_SIZE=5

# --- Executive AI briefing (see briefing/, api/briefing.py) ---
# An evidence-linked daily/weekly/monthly summary of KPI movement,
# anomalies, drivers, risks, opportunities, unresolved recommendations
# and data-quality issues, assembled from records other governed
# subsystems already wrote. ON by default: a pure read of records the
# caller is already authorized to see -- it never queries a monitored
# database, never calls an LLM, never makes an outbound call, and
# persists nothing.
# ENABLE_EXECUTIVE_BRIEFING=true
# How old evidence may be before a briefing of each cadence marks it
# stale. Three budgets rather than one, because the honest threshold
# scales with the cadence: evidence gathered a week ago is misleading in
# a daily briefing and entirely normal in a monthly one. A stale claim is
# marked and ranked below fresh claims, never dropped.
# BRIEFING_STALE_AFTER_DAILY_HOURS=36.0
# BRIEFING_STALE_AFTER_WEEKLY_HOURS=192.0
# BRIEFING_STALE_AFTER_MONTHLY_HOURS=840.0
# Claims kept per section, ranked before truncation; the affected
# sections are named in the response, never silently shortened.
# BRIEFING_MAX_ITEMS_PER_SECTION=10
# Tier a finding must reach before a *second*, inferred risk/opportunity
# claim is made about it. Never gates the observed movement itself.
# BRIEFING_RISK_MIN_TIER=medium
# Payload bound on the one source that arrives in the request body
# (nothing in this codebase persists a data-quality scan).
# BRIEFING_MAX_DATA_QUALITY_FINDINGS=200

# --- Executive Decision Center (see decision_center/, api/decision_center.py) ---
# One read model over everything Prompts 33-50 record: business health,
# KPI movement, anomalies, risks, recommendations, pending decisions,
# actions and outcomes, each drillable to its own evidence. ON by
# default: it is a pure read model over governed records already in the
# identity database -- it never queries a monitored database, generates
# SQL or calls an LLM.
# ENABLE_DECISION_CENTER=true
# Most decision chains one briefing assembles (signal -> evidence ->
# explanation -> recommendation -> action -> outcome). Chains are
# expensive to *read*, not to compute.
# DECISION_CENTER_MAX_CHAINS=10

# --- Database connection ---
# DB_TYPE selects the driver: postgresql | mysql | mssql | oracle
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_readonly_user
DB_PASSWORD=your_password
# Optional: restrict introspection (and what the LLM sees) to one schema
# instead of the whole database. Leave blank to use the connection's default.
DB_SCHEMA=
# Optional: full connection-string override. If set, DB_TYPE/DB_HOST/DB_PORT/
# DB_NAME/DB_USER/DB_PASSWORD above are ignored entirely.
DB_CONNECTION_STRING=
# Only used when DB_TYPE=mssql -- must match an ODBC driver installed on
# this machine (Control Panel > ODBC Data Sources, or `odbcinst -j` on
# Linux/macOS). Common values: "ODBC Driver 17 for SQL Server",
# "ODBC Driver 18 for SQL Server".
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Connection-pool sizing for every configured database's engine. The
# SQLAlchemy default (pool_size=5) is fine for a single user; raise these
# once more than a handful of callers query the same database at once,
# since each held connection is one execute_sql_node/POST /execute call
# in flight. DB_MAX_OVERFLOW is the burst ceiling above DB_POOL_SIZE
# before a caller waits for a connection.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Multiple databases (optional) ---
# Leave DB_CONNECTIONS unset for a plain single-database setup (the DB_* block
# above is used as-is, internally named "default"). To connect to more than
# one database and have the agent auto-route each question to whichever one
# looks relevant (see embeddings/retriever.py::select_database -- no manual
# picker, the agent decides), set DB_CONNECTIONS to a comma-separated list of
# names, then repeat the same DB_* fields per name as DB_<NAME>_*
# (the name uppercased, non-alphanumeric characters replaced with `_`):
#
# DB_CONNECTIONS=sales,hr
# DB_SALES_TYPE=postgresql
# DB_SALES_HOST=sales-db.internal
# DB_SALES_PORT=5432
# DB_SALES_NAME=sales
# DB_SALES_USER=sales_reader
# DB_SALES_PASSWORD=...
# DB_HR_TYPE=mysql
# DB_HR_HOST=hr-db.internal
# DB_HR_PORT=3306
# DB_HR_NAME=hr
# DB_HR_USER=hr_reader
# DB_HR_PASSWORD=...
#
# Each connection also accepts its own DB_<NAME>_SCHEMA, DB_<NAME>_CONNECTION_STRING,
# and DB_<NAME>_ODBC_DRIVER, matching the unprefixed fields above.
#
# Multi-tenant deployments only (see docs/MULTI_TENANCY.md): DB_<NAME>_TENANT_IDS
# restricts a connection to specific tenants. Unset (the default, and what every
# single-tenant deployment wants) means the connection is shared by every tenant
# -- which is exactly the behavior this file described before the setting existed,
# so leaving it out changes nothing. Once set, callers in any other tenant get
# the same "unknown database" 404 a nonexistent name gets, and the agent's own
# auto-routing never even considers it:
#
# DB_SALES_TENANT_IDS=acme
# DB_HR_TENANT_IDS=acme,globex
DB_CONNECTIONS=

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./embeddings/.chroma
CHROMA_COLLECTION_NAME=schema_ddl
# Sentence-transformers model used for embedding schema DDL and questions.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SCHEMA_TOP_K=4

# --- Agent limits (see CLAUDE.md "Sandbox/resource limits") ---
MAX_RETRIES=3
# Extra retries (on top of MAX_RETRIES) for questions that look like they need
# more self-correction cycles (top-N-per-group, YoY/period growth, multiple
# metrics at once) -- see agent/complexity.py. 0 disables the adaptive bonus.
COMPLEX_QUERY_MAX_RETRY_BONUS=2
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=1024
# Max tokens for the post-query plain-English insight sentence (1-2
# sentences, so kept much smaller than LLM_MAX_TOKENS above).
INSIGHT_MAX_TOKENS=120
# Max accepted length (characters) of a typed question -- rejected with a
# clear message rather than silently truncated (see agent/input_guard.py).
MAX_QUESTION_LENGTH=5000
# Max prior turns from a caller-supplied conversation_history that are
# ever processed -- older turns beyond this count are dropped, keeping
# only the most recent ones (agent/input_guard.py::sanitize_conversation_history).
MAX_CONVERSATION_HISTORY_TURNS=20

# --- Conversational context resolution (agent/context_resolution.py) ---
# How a short follow-up ("Price?", "Make it more professional.", "I meant
# 60,000") is read against the conversation before it, and rewritten into
# a standalone question for schema retrieval, source routing and the
# generation prompt. See docs/CONVERSATIONAL_CONTEXT.md.
#
# The rollback switch. false restores the previous behaviour exactly: the
# regex-only classifier, the antecedent bound to the most recent turn,
# and no rewrite.
ENABLE_CONTEXT_RESOLUTION=true
# How many recent *successful* turns are eligible to be the turn a
# reference resolves against. Older turns are quoted into the memory
# digest rather than dropped. This is the resolution window; the cap on
# the whole caller-supplied array is MAX_CONVERSATION_HISTORY_TURNS above.
CONTEXT_RESOLUTION_RECENT_TURNS=6
# Whether an unsure deterministic resolution may escalate to one small
# ROUTER_MODEL call. Off by default: measured at 11.1s on this hardware,
# on the user's latency path, before any retrieval or generation starts
# (docs/PERFORMANCE.md). Turning it on is a deliberate
# latency-for-accuracy trade. The deterministic tier is unaffected.
ENABLE_CONTEXT_RESOLUTION_LLM=false
# The confidence below which that escalation happens. A judgement call,
# not a measurement -- it leans toward answering rather than asking.
CONTEXT_RESOLUTION_MIN_CONFIDENCE=0.60
# Generation cap for that call. One JSON object, so small and separate
# from LLM_MAX_TOKENS.
CONTEXT_RESOLUTION_MAX_TOKENS=256

# --- No-retrieval answering (agent/orchestrator/general_knowledge.py) ---
# Whether the router's general_knowledge/conversation routes are answered
# from the model's own knowledge, instead of returning a fixed "I couldn't
# match that to a data source" message. Turning this on makes the platform
# a general assistant as well as a governed data platform: writing,
# planning, coding and explanation questions get real answers, each
# carrying a fixed "answered from general knowledge, not your data"
# disclaimer in the answer text.
#
# Off by default, deliberately. The router picks general_knowledge
# *because* it could not match the question to a source -- sometimes
# because no data is needed, sometimes because routing missed a real data
# question. For the second, a fluent model answer replaces a helpful
# routing failure with a confident unsourced claim about the business.
# It also costs one model call per unmatched question.
ENABLE_GENERAL_KNOWLEDGE_ANSWERS=false
GENERAL_KNOWLEDGE_MAX_TOKENS=800

# --- Where a question's prior turns come from (api/conversation_context.py) ---
# "client" (the default) takes them from the array the client resends on
# every request. "server" reads them from this deployment's own chat store
# instead, for a locally-authenticated caller with a conversation_id.
#
# "server" means an edit or delete actually changes the next answer's
# context, and the text the resolver reasons over is this server's record.
# It costs the chat UI's per-turn "remove from context" control, which
# works precisely because the client is what sends the history.
CONVERSATION_HISTORY_SOURCE=client

# --- Agentic query planning + plan-conformance self-correction
# (agent/nodes.py::plan_query_node / review_sql_node) ---
# Only triggers for questions agent/complexity.py judges non-trivial (same
# signals as COMPLEX_QUERY_MAX_RETRY_BONUS above) -- an ordinary question
# makes zero extra LLM calls regardless of this flag being on.
ENABLE_QUERY_PLANNING=true
QUERY_PLAN_MAX_TOKENS=300
SQL_REVIEW_MAX_TOKENS=200

# --- Golden-dataset feedback loop (embeddings/golden_examples.py,
# agent/nodes.py::retrieve_golden_examples_node) ---
# A thumbs-up on a confirmed-correct result in the UI saves that
# (question, SQL) pair to a per-database ChromaDB collection; the
# best-matching saved examples are retrieved and injected as few-shot
# examples into future similar questions. Safe no-op until a user has
# saved at least one example -- nothing to retrieve yet.
ENABLE_GOLDEN_EXAMPLES=true
GOLDEN_EXAMPLES_TOP_K=3
# Minimum cosine similarity (0.0-1.0) a saved example must clear to
# actually be injected -- a poor match is withheld entirely rather than
# shown, since a misleading example is worse than none.
GOLDEN_EXAMPLES_MIN_SIMILARITY=0.75

# --- Business-context vector retrieval (retrieval/, scripts/ingest_schema.py,
# scripts/rebuild_index.py -- see docs/vector-retrieval-design.md) ---
# Adds semantic retrieval of table/column/relationship descriptions,
# business glossary terms, metric definitions, curated SQL examples, and
# documentation on top of (never instead of) the live schema introspection
# already scoping SQL generation above. Reuses this project's existing
# ChromaDB PersistentClient (CHROMA_PERSIST_DIR above) -- no second vector
# database, no new required infrastructure. Safe no-op until you run
# `python -m scripts.ingest_schema --database-id <name>` at least once --
# nothing to retrieve yet, and retrieval fails open (see the design doc's
# "Fallback behavior" section) regardless.
ENABLE_BUSINESS_CONTEXT_RETRIEVAL=true
# Chroma collection name prefix -- actual collections are suffixed
# "__<database_id>", same per-database convention as CHROMA_COLLECTION_NAME.
RETRIEVAL_COLLECTION_NAME=knowledge_base
# "local" (default) reuses EMBEDDING_MODEL_NAME's runtime above -- no API
# key, no network call. "fake" is a deterministic, non-semantic embedding
# with zero model/network dependency, used by this project's own test
# suite; only set this in a real deployment if you have no embedding
# runtime available and only need to exercise the retrieval plumbing.
RETRIEVAL_EMBEDDING_PROVIDER=local
# Only used when RETRIEVAL_EMBEDDING_PROVIDER=fake.
RETRIEVAL_FAKE_EMBEDDING_DIMENSIONS=32
# If set, validated against the configured provider's actual output width
# at ingestion/retrieval time -- a clear, early error instead of a cryptic
# Chroma dimension-mismatch exception. Leave blank to accept whatever the
# configured provider produces.
# RETRIEVAL_EMBEDDING_DIMENSIONS=384
RETRIEVAL_SIMILARITY_METRIC=cosine
RETRIEVAL_EMBEDDING_BATCH_SIZE=32
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=30
RETRIEVAL_EMBEDDING_RETRY_COUNT=2
# Separate, bounded top-k per chunk type -- see retrieval/retriever.py's
# docstring for why these are never one shared/unbounded limit.
RETRIEVAL_TOP_K_TABLES=5
RETRIEVAL_TOP_K_COLUMNS=8
RETRIEVAL_TOP_K_RELATIONSHIPS=5
RETRIEVAL_TOP_K_GLOSSARY=3
RETRIEVAL_TOP_K_METRICS=3
RETRIEVAL_TOP_K_SQL_EXAMPLES=3
RETRIEVAL_TOP_K_DOCUMENTATION=3
# Minimum cosine similarity (0.0-1.0) a chunk must clear to be considered at all.
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
# The tighter of these two budgets wins when trimming the final retrieved
# context injected into the SQL-generation prompt.
RETRIEVAL_MAX_CONTEXT_CHARS=6000
RETRIEVAL_MAX_CONTEXT_TOKENS=1500
# retrieval/reranker.py's final_score formula: weight of raw vector
# similarity vs. chunk-type priority, and how strongly a repeated
# (chunk_type, table_name) pair is discounted during diversity re-selection.
RETRIEVAL_RERANK_WEIGHT=0.6
RETRIEVAL_DIVERSITY_WEIGHT=0.3
RETRIEVAL_DOCUMENTATION_CHUNK_CHARS=1500
RETRIEVAL_DOCUMENTATION_CHUNK_OVERLAP_CHARS=200
# Where scripts/ingest_schema.py reads glossary.yaml/metrics.yaml/
# sql_examples.yaml/documentation/* from -- relative paths resolve against
# the project root, same convention as CHROMA_PERSIST_DIR above.
RETRIEVAL_KNOWLEDGE_DIR=./data/knowledge

# Note: role/tenant scoping for retrieved chunks (Chunk.allowed_roles) is
# always derived server-side from the authenticated caller's own roles
# (AuthIdentity.roles -> AgentState["caller_roles"], see agent/authz.py) --
# there is no separate TENANT_ID/ROLE env var here, since this app has no
# client-supplied filter path for retrieval to trust in the first place
# (see docs/vector-retrieval-design.md's security section).

# --- Rate limiting (see agent/rate_limit.py; a real but still process-local
# safeguard -- not yet distributed across multiple replicas, see SECURITY.md
# and docs/SCALE_OUT_PROMPT.md's Phase 3) ---
# Max question submissions per minute, per caller (authenticated subject when
# local/OIDC auth is on, else client IP).
QUESTION_RATE_LIMIT_PER_MINUTE=10
# Max LLM *generation* calls per minute, process-wide -- stricter than and
# separate from the above, since one question's retries can multiply calls.
LLM_CALL_RATE_LIMIT_PER_MINUTE=20
# Max POST /ask executions allowed to run at once, process-wide -- an
# in-flight concurrency cap (distinct from the per-minute rate limit above),
# and what sizes the bounded ask-worker thread pool. A caller past this gets
# an immediate 429, not a queued wait.
MAX_CONCURRENT_ASK_REQUESTS=50
# Max POST /ask executions one caller may have in flight at once (same
# caller key as QUESTION_RATE_LIMIT_PER_MINUTE) -- a fairness bound, not a
# throughput control.
MAX_CONCURRENT_ASK_REQUESTS_PER_CALLER=2

# --- Asynchronous question queue (jobs/) ---
# This is what lets ONE authenticated user run many questions at once.
# Distinct from MAX_CONCURRENT_ASK_REQUESTS_PER_CALLER just above: that
# bounds the *synchronous* POST /ask, where the caller is blocking on a
# response and a small cap plus an immediate 429 is the right behaviour.
# Here the caller gets a job id back from POST /questions, so exceeding
# the cap QUEUES the question instead of refusing it.
#
# Queued questions run through the same governed pipeline POST /ask uses
# -- same SQL validator, same row cap, same result governance. See
# docs/CONCURRENCY.md.
#
# Set false to answer every /questions route with 503 instead of
# unrouting it, so a frontend shows a clear message rather than a 404.
ENABLE_QUESTION_QUEUE=true
# How many questions ONE authenticated user may have RUNNING at once.
# Hard-capped in code at 500 (config.settings
# .MAX_SAFE_CONCURRENT_QUESTIONS_PER_USER): a non-numeric, zero, negative
# or above-500 value is rejected at startup, not clamped. Every running
# question holds a worker thread, a pooled database connection and an
# in-flight Ollama call for its full duration, so raise this together
# with DB_POOL_SIZE/DB_MAX_OVERFLOW and
# LLM_CALL_RATE_LIMIT_PER_MINUTE -- startup warns when they disagree.
MAX_CONCURRENT_QUESTIONS_PER_USER=100
# Process-wide ceiling across every user. Must be >= the per-user cap, or
# startup fails: a global below the per-user value would make the
# per-user value a number nobody could ever reach.
MAX_CONCURRENT_QUESTIONS_GLOBAL=500
# Wall-clock budget for one question, measured from when it starts
# RUNNING (queue wait is not the model's fault and does not consume it).
# Reaching it gives the job status TIMEOUT, which is deliberately
# distinct from FAILED.
QUESTION_TIMEOUT_SECONDS=120
# How long a question may sit QUEUED before the queue gives up and marks
# it TIMEOUT. Without this, a polling client cannot tell "still waiting"
# from "will never run".
QUESTION_QUEUE_WAIT_TIMEOUT_SECONDS=900
# Backpressure. Beyond this many QUEUED jobs, submission is refused with
# 429 rather than accepting work with no prospect of running -- an
# unbounded queue is a memory leak with a progress bar.
QUESTION_QUEUE_MAX_DEPTH=1000
# One user's share of that depth, so a single user cannot fill the shared
# queue and starve everyone else. Must be <= QUESTION_QUEUE_MAX_DEPTH.
QUESTION_QUEUE_MAX_DEPTH_PER_USER=200
# How long a finished job and its result stay readable. A stored result is
# re-governed against the *current* reader's roles on every read, so this
# is a retention budget, not a trust window.
QUESTION_RESULT_TTL_SECONDS=3600
# How long a submission's idempotency key is remembered, so a retried
# submit returns the original job instead of starting a second run.
QUESTION_IDEMPOTENCY_TTL_SECONDS=900
# Hard cap on jobs retained per user, bounding memory against a burst
# that arrives faster than the TTL above can expire it.
QUESTION_MAX_RETAINED_JOBS_PER_USER=500
# Automatic retries of a job whose failure the harness classified as
# transient. Exponential backoff with jitter comes from
# agent.harness.retry. 0 disables job-level retry; the graph's own
# self-correction loop (MAX_RETRIES) is separate and unaffected.
QUESTION_MAX_RETRIES=2
# Seconds a graceful shutdown waits for in-flight jobs. Queued jobs are
# cancelled immediately; running ones are signalled to stop at their next
# node boundary.
QUESTION_SHUTDOWN_GRACE_SECONDS=30
# Per-execution ceilings the agent harness enforces. MAX_TOOL_CALLS and
# MAX_TOKENS_PER_REQUEST in the brief map to these two, which already
# owned those budgets -- one owner per fact (CLAUDE.md 4.8).
# HARNESS_MAX_TOOL_CALLS=30
# HARNESS_MAX_TOKENS=0
# Max calls per minute, per client IP, to POST /execute, POST /schema/refresh,
# the mutating /documents routes, POST /generate/confirm, and (Prompt 21)
# POST /feedback/golden-example and POST /feedback/message.
API_ACTION_RATE_LIMIT_PER_MINUTE=20

# --- Onboarding connection-test rate limit (Prompt 21, see agent/rate_limit.py
# ::get_onboarding_connection_test_limiter) ---
# Max connection attempts per hour, per authenticated admin, across
# POST /onboarding/jobs, .../discover, and .../publish -- each opens a live
# outbound connection to a caller-supplied db_host/db_port. Already gated
# behind the admin-only ONBOARDING_MANAGE permission; this is a second,
# defense-in-depth bound on top, closing what would otherwise be a
# repeatable TCP-connect oracle against any host/port an admin names.
ONBOARDING_CONNECTION_RATE_LIMIT_PER_HOUR=10

# --- Per-database execution concurrency (see agent/rate_limit.py
# ::get_database_execution_limiter) ---
# Fast-fails a query once the target database already has
# DB_POOL_SIZE + DB_MAX_OVERFLOW + the overhead below real executions in
# flight, instead of blocking on QueuePool checkout for up to SQLAlchemy's
# 30s pool_timeout only to fail anyway. Below saturation the limiter never
# trips, so this restricts nothing that currently works.
ENABLE_DATABASE_CONCURRENCY_LIMIT=true
# Extra headroom before the limiter trips. 0 means "fail exactly where the
# pool itself would start blocking"; raise it to let a few callers queue on
# the pool first.
DATABASE_CONCURRENCY_LIMIT_OVERHEAD=0

# --- POST /execute result cache (see db/result_cache.py) ---
# Opt-in, and off by default: caching trades data freshness for latency, so
# it is an operator decision rather than a safe-by-default accuracy aid.
# Serves a cached (columns, rows) result for exact-text-identical SQL
# against the same database, partitioned by the caller's tenant. SQL
# referencing a config/sensitive_columns.yaml "restricted" column is never
# cached regardless of this flag. The agent's own internal self-correction
# retries are never cached -- only the user-facing "Confirm and Run" path.
ENABLE_RESULT_CACHE=false
# How long a cached result stays fresh before it's re-executed.
RESULT_CACHE_TTL_SECONDS=30
# Bound on distinct (tenant, database, SQL) entries held in memory, LRU-evicted
# past this.
RESULT_CACHE_MAX_ENTRIES=500

# --- Proactive query cost estimation (see db/query_cost.py) ---
# Runs a non-executing EXPLAIN/SHOWPLAN before a validated query executes.
# Always fails open (skips the check) on any error or timeout.
COST_ESTIMATION_ENABLED=true
COST_ESTIMATION_TIMEOUT_SECONDS=3
# Estimated rows above which a query still runs, but the UI shows a
# "this may take a moment" notice first.
COST_MODERATE_ROW_THRESHOLD=50000
# Estimated rows above which a query is not run at all -- treated as a
# retryable error fed back to the generation node instead.
COST_HIGH_ROW_THRESHOLD=1000000

# --- Logging ---
LOG_LEVEL=INFO
# How much result-set shape observability/redaction.py includes when
# logging a query result -- "standard" (row/column counts + column names,
# never cell values) or "strict" (drops column names too, leaving only
# counts -- column names can themselves be sensitive in some schemas).
LOG_REDACTION_LEVEL=standard
# "text" (default) is this app's original terminal-friendly log format --
# no change for local dev. Set to "json" for a real log-aggregation
# pipeline (ELK/CloudWatch/Datadog/Loki) that needs one JSON object per
# line instead. See docs/CONFIGURATION.md's "Observability" section.
LOG_FORMAT=text

# --- Reverse proxy / load balancer (enterprise scalability assessment) ---
# 0 (default) is this app's original, deliberately-tested behavior: never
# trust X-Forwarded-For/X-Real-IP, since a directly-exposed instance has no
# proxy in front of it and trusting client-suppliable headers would let a
# caller spoof its own rate-limit/audit-log identity. Set this to the exact
# number of trusted reverse proxies/load balancers between the internet and
# this process (usually 1) ONLY when you have actually put that many in
# front of it -- see docs/DEPLOYMENT.md and security/client_ip.py's own
# docstring for why this must be an exact hop count, never "trust the
# header if present."
TRUSTED_PROXY_COUNT=0

# --- REST API (api/, see docs/API.md) ---
# Optional bearer token required on every api/ request when set (checked
# against the `Authorization: Bearer <token>` header). Leave blank to run
# the API with no auth check of its own -- fine for local/trusted-network
# use, but see docs/DEPLOYMENT.md before exposing it beyond that: this is a
# lightweight hook, not a substitute for a real authenticating reverse proxy.
# See docs/AUTHENTICATION.md's "Combining modes" -- can be set *alongside*
# OIDC below (service/CI callers use this, interactive users use OIDC).
API_AUTH_TOKEN=

# --- Deployment posture (see config/settings.py's own docstring) ---
# "development" (default) or "production". Only consequence today:
# ENVIRONMENT=production refuses to start at all if neither API_AUTH_TOKEN
# above nor OIDC_ISSUER below is configured -- see docs/AUTHENTICATION.md.
ENVIRONMENT=development

# --- OIDC/JWT authentication (production-grade -- see docs/AUTHENTICATION.md
# for the full picture, including what each field validates and why) ---
# Any standard OIDC-compliant identity provider works: Auth0, Okta, Azure
# AD/Entra ID, Keycloak, or a self-hosted one. Leave OIDC_ISSUER blank (the
# default) to leave this mode off entirely -- API_AUTH_TOKEN/no-auth above
# behave exactly as they always did.
OIDC_ISSUER=
# Required whenever OIDC_ISSUER is set (refuses to start otherwise) -- the
# API identifier your IdP mints access tokens for. Without this, a validly-
# signed token from *any* other application at the same identity provider
# would be accepted too.
OIDC_AUDIENCE=
# Optional -- discovered from <issuer>/.well-known/openid-configuration if
# left blank. Only set this if your provider doesn't support standard OIDC
# discovery.
OIDC_JWKS_URL=
# Comma-separated allowlist, read from server-side config only -- never
# from the token's own `alg` header (the standard "alg confusion" defense).
# Must never include "none" (refuses to start if it does).
OIDC_ALGORITHMS=RS256
# Leeway (seconds) for ordinary clock drift between this server and the IdP
# when checking token expiration/not-before.
OIDC_CLOCK_SKEW_SECONDS=60
# Which JWT claim carries the caller's role(s) -- see docs/AUTHORIZATION.md
# for the role -> permission mapping (agent/authz.py).
OIDC_ROLE_CLAIM=roles
# Which IdP-signed JWT claim carries the caller's tenant id (multi-tenant
# deployments only -- see docs/MULTI_TENANCY.md). Unset (the default) means
# every OIDC caller resolves to the single "default" tenant, which is this
# app's pre-multi-tenant behavior. Only ever read from a token whose signature
# has already been verified against the issuer's live JWKS -- a tenant is never
# accepted from a request header or body, and a request carrying an
# X-Tenant-Id-style header is refused outright with a 400.
OIDC_TENANT_CLAIM=

# --- Local user accounts / identity database (optional, off by default --
# see identity/, docs/AUTH_USER_MANAGEMENT.md) ---
# A dedicated PostgreSQL database for this app's own self-hosted user
# accounts, RBAC, sessions, and AI activity history -- NEVER the same
# database as DB_CONNECTIONS above (the business/HR data the agent
# queries). Leave LOCAL_AUTH_ENABLED unset/false (the default) to leave
# this feature off entirely -- OIDC/API_AUTH_TOKEN/no-auth above behave
# exactly as they always did; all four mechanisms can be configured
# simultaneously (see docs/AUTHENTICATION.md's "Combining modes").
LOCAL_AUTH_ENABLED=false
# Required whenever LOCAL_AUTH_ENABLED=true (refuses to start otherwise).
AUTH_DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/text_to_sql_identity
AUTH_DATABASE_POOL_SIZE=10
AUTH_DATABASE_MAX_OVERFLOW=20
AUTH_DATABASE_POOL_RECYCLE_SECONDS=1800

# Whether POST /auth/register accepts unauthenticated self-service sign-ups
# at all. False by default -- provision accounts via POST /admin/users
# unless you explicitly want open registration.
ALLOW_PUBLIC_REGISTRATION=false
# Whether a new account starts "pending_verification" until POST
# /auth/verify-email succeeds, instead of "active" immediately. False by
# default -- email verification requires your own outbound-mail
# integration (see docs/AUTH_USER_MANAGEMENT.md).
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_MIN_LENGTH=12
# Passwords longer than this are rejected outright, never silently
# truncated -- see identity/password_policy.py and
# docs/authentication-and-password-policy.md.
PASSWORD_MAX_LENGTH=64
# Failed sign-in attempts (per account) before a temporary lockout.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# How long a POST /auth/forgot-password reset token stays redeemable.
# Single-use regardless -- redeeming it (or letting it expire) both
# permanently retire it.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Same meaning, for POST /auth/verify-email tokens -- deliberately
# longer-lived (a day) since a verification email is lower-urgency than a
# password-reset request.
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
# This app's own externally-reachable origin, used only to build the link
# inside a password-reset/verification "email" (identity/email.py --
# today a disclosed console-log placeholder, not real mail delivery).
APP_BASE_URL=http://localhost:8000

# --- Google sign-in (optional, requires LOCAL_AUTH_ENABLED=true above --
# see security/google_oidc.py, docs/AUTHENTICATION.md) ---
# Your Google Cloud OAuth 2.0 Web Client ID -- a PUBLIC identifier, safe to
# ship to the browser (via GET /health's google_client_id field, never
# baked into the frontend build) and to commit in docs/screenshots. This is
# NOT a secret and is never called one anywhere in this codebase -- unlike
# an OAuth client *secret*, which this app deliberately never requests or
# stores at all (see docs/AUTHENTICATION.md's "Why no client secret").
# Leave blank (the default) to leave Google sign-in off entirely -- local
# email/password accounts behave exactly as they always did.
GOOGLE_OAUTH_CLIENT_ID=
# Optional Google Workspace domain restriction (comma-separated, e.g.
# "example.com,example.org"). Empty (default) means any verified Google
# account may sign in. Validated against the token's own signed `hd`
# claim -- never inferred from an @domain email suffix.
GOOGLE_OAUTH_ALLOWED_HOSTED_DOMAINS=
# Leeway (seconds) for the Google ID token's iat/exp validation -- same
# purpose as OIDC_CLOCK_SKEW_SECONDS above, kept separate since Google
# sign-in doesn't share security/oidc.py's validation path.
GOOGLE_OAUTH_CLOCK_SKEW_SECONDS=60
# How long a server-issued sign-in nonce (GET /auth/google/nonce) stays
# claimable before it expires unused.
GOOGLE_OAUTH_NONCE_TTL_SECONDS=300

# --- Secure conversation sharing (optional, requires LOCAL_AUTH_ENABLED=true
# above -- see identity/share_policy.py, docs/SHARING_SECURITY.md) ---
# Master switch for the whole feature. True by default; local-account
# owners can share a conversation with invited members even with the
# public-link switch below left off.
ENABLE_CONVERSATION_SHARING=true
# A deliberately separate, deny-by-default switch: even with sharing on,
# an owner can only create an "anyone with the link" share once this is
# explicitly turned on. Invite-only sharing works with this left off.
SHARE_PUBLIC_LINKS_ENABLED=false
# Default expiry (days) for a new share, and for a re-share after
# revocation -- always finite, shown in the owner UI.
SHARE_DEFAULT_EXPIRY_DAYS=30
# How long an invited member's own accept link stays valid.
SHARE_INVITATION_EXPIRY_DAYS=14
# Anti-abuse cap on invited members per share.
SHARE_MAX_MEMBERS_PER_CONVERSATION=50
# Per-IP rate limit on the anonymous-reachable GET /share-view/{ref} (and
# its attachment sibling) -- the only sharing routes with no authenticated
# caller identity to key a limiter on.
SHARE_LINK_ACCESS_RATE_LIMIT_PER_MINUTE=30
# Per-caller rate limit on inviting members, regenerating a link, and
# accepting an invitation.
SHARE_INVITE_RATE_LIMIT_PER_HOUR=20

# --- Server-side chat history (identity/repositories/history.py,
# api/chat_history.py -- see docs/chat-history-architecture.md) ---
# Default/maximum page sizes for GET /conversations and
# GET /conversations/{id}/messages -- a client-supplied `limit` above the
# max is clamped server-side, never trusted as-is.
CHAT_HISTORY_PAGE_SIZE=30
CHAT_HISTORY_MAX_PAGE_SIZE=100
# Same, for GET /chat/search.
CHAT_SEARCH_PAGE_SIZE=20
CHAT_SEARCH_MAX_PAGE_SIZE=50
# Bounds on what gets persisted into a saved turn's metadata for later
# reload (api/chat_persistence.py) -- independent of the live response,
# which is never truncated. A saved conversation showing "first 50 of 500
# rows" on reopen is an accepted tradeoff against storing an unbounded
# result snapshot per turn forever.
CHAT_HISTORY_MAX_RESULT_ROWS=50
CHAT_HISTORY_MAX_TEXT_CHARS=4000

# JWT signing for locally-issued access tokens. HS256 (a shared secret,
# JWT_SECRET_KEY) is the zero-friction local-dev default; RS256/ES256
# (asymmetric, JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH) are the
# production-grade options -- see docs/AUTH_USER_MANAGEMENT.md for when to
# graduate. Generate a strong HS256 secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=text-to-sql-agent
JWT_AUDIENCE=text-to-sql-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Refresh-token cookie settings (never localStorage -- see
# frontend/src/lib/localAuth.ts once built). COOKIE_SECURE should only
# ever be false for plain-HTTP local development.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Per-client-IP rate limits on the auth endpoints this feature's own spec
# calls out specifically (independent of API_ACTION_RATE_LIMIT_PER_MINUTE
# above, which covers other routes).
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# Safe first-admin-account bootstrap (scripts/bootstrap_admin.py) --
# deliberately a separate, explicit opt-in beyond just setting the two
# credential fields below, so a production .env with leftover bootstrap
# credentials can't accidentally re-provision an admin later. Also
# idempotent regardless -- re-running with an existing admin account is a
# safe no-op.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Whether prompt/AI-output or voice-transcript *content* (not metadata) may
# ever appear in an ordinary log line -- never in security.audit_log events
# regardless. False by default; opt-in for development debugging only.
LOG_PROMPT_CONTENT=false
LOG_VOICE_TRANSCRIPT_CONTENT=false

# --- Frontend OIDC login (React dashboard, see frontend/src/lib/auth.ts's
# module docstring) ---
# 2026 Phase 3: closes the gap where the shipped dashboard had no way to
# obtain a real per-user OIDC token, only the shared API_AUTH_TOKEN above
# (which grants full admin -- see docs/AUTHENTICATION.md). These are
# **build-time** Vite env vars (baked into the built JS at `npm run
# build`/`npm run dev`, not read by the Python backend) and are NOT
# secrets -- a public OIDC client (Authorization Code + PKCE, no
# client_secret) is designed to be embedded in a public SPA. Leave
# VITE_OIDC_AUTHORITY/VITE_OIDC_CLIENT_ID blank (the default) to leave the
# dashboard's login screen off entirely -- it falls back to
# VITE_API_AUTH_TOKEN (a build-time copy of API_AUTH_TOKEN above) or no
# auth, exactly as it always did.
#
# Must be registered as a separate OIDC client (a "public"/SPA client, not
# the same client_id a backend service might use) at your identity
# provider, with VITE_OIDC_REDIRECT_URI below registered as an allowed
# redirect URI there.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Defaults to "openid profile" if unset.
VITE_OIDC_SCOPE=
# Defaults to "<this app's own origin>/auth/callback" if unset -- only
# override if you're deploying the frontend at a non-root path.
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
# A build-time copy of API_AUTH_TOKEN above, for the dashboard to use as a
# fallback when OIDC isn't configured (or as the only credential, for a
# trusted-network/single-operator deployment) -- Vite only exposes
# VITE_-prefixed variables to browser code, so this must be set separately,
# not inferred from API_AUTH_TOKEN.
VITE_API_AUTH_TOKEN=

# --- Future hosted-model swap (unused by the local flow, kept for parity) ---
# HOSTED_LLM_API_KEY=

# --- Multi-source router (see agent/orchestrator/graph.py's module docstring;
# docs/ARCHITECTURE.md gets a matching section once the multi-source design
# lands in full) ---
# Required only if you want questions routed through agent/orchestrator/
# instead of straight to the SQL agent. False (or unset) makes
# agent.orchestrator.graph.run_orchestrated a pure pass-through to
# agent.graph.run_agent -- the app behaves exactly as it does with this
# whole section left unset. Turning it on today (before any document/
# policy/web source is configured below) still only ever routes to SQL --
# it just makes that routing an inspectable, logged graph step instead of a
# bare function call.
ENABLE_MULTI_SOURCE_ROUTER=false

# When a question arrives with no source picked in the composer, search
# every configured retrieval source -- database, both document
# collections, and web -- instead of asking the LLM to choose. On by
# default because which sources a question reached otherwise depends on
# how well the configured local model follows the routing prompt, and
# that varies: on "provide me the sick leave policy", llama3.1:8b picked
# both document collections while qwen2.5-coder:7b picked the policy one
# alone and missed the PDF filed under documents.
#
# The trade is latency and web-search cost: every unselected question also
# runs the SQL pipeline and a web search. SESSION_EXPENSIVE_SOURCE_LIMIT
# still caps the web spend per session. Set false to go back to LLM
# classification. Needs ENABLE_MULTI_SOURCE_ROUTER=true to do anything.
#
# Never fans in `generation` or `media_search` (generation creates a paid
# artifact rather than retrieving one), never overrides a source you
# picked yourself, and never applies to attachment-only questions.
# ROUTE_TO_ALL_SOURCES=true

# --- Document/policy RAG store (see rag/store.py's module docstring) ---
# A dedicated SQL Server 2025+/Azure SQL connection for uploaded PDF chunks +
# embeddings (native VECTOR column type -- confirmed against the actual
# target instance before this was built). Deliberately separate from
# DB_CONNECTIONS above -- chunk storage isn't business data and shouldn't
# share a schema/connection pool with a configured database. Required for
# ENABLE_DOCUMENT_RAG and/or ENABLE_POLICY_RAG below; leave blank and both
# stay unavailable regardless of those flags.
#
# Same LocalDB-style escape hatch as DB_HR_CONNECTION_STRING above if your
# SQL Server instance needs one (named instance, no TCP host:port):
# RAG_STORE_CONNECTION_STRING=mssql+pyodbc:///?odbc_connect=<url-encoded ODBC connection string>
RAG_STORE_CONNECTION_STRING=
RAG_STORE_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Offers the general "documents" collection to the router. Upload PDFs to it
# from the "Knowledge Sources" page in the UI (ui/pages/1_Knowledge_Sources.py).
ENABLE_DOCUMENT_RAG=false
# Offers the separate, more access-sensitive "policies" collection to the
# router -- independent of ENABLE_DOCUMENT_RAG, either can be on alone. A
# policy PDF tagged with a sensitivity category (compensation/disciplinary/
# legal) at upload time is never summarized into an answer -- see
# rag/graph.py's generate-node docstring for why.
ENABLE_POLICY_RAG=false

# Retrieval/chunking tuning shared by both collections.
RAG_TOP_K=4
RAG_MAX_RETRIES=2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
# Blank (default) reuses EMBEDDING_MODEL_NAME above -- the same model already
# embedding schema DDL. Only set this if documents genuinely need a
# different embedding model than schema retrieval does.
RAG_EMBEDDING_MODEL_NAME=
# Stores each uploaded PDF's original bytes (a new column on rag.documents)
# so it can be downloaded later from a chat answer's citation or the
# Knowledge Sources page. True by default -- a real, visible storage-growth
# cost on top of the extracted chunks, unlike the other ENABLE_* flags above,
# so turn this off if that matters for your deployment. Only ever applies to
# documents uploaded after this is turned on.
ENABLE_PDF_DOWNLOAD=true
# Upper bound (MB) on one POST /documents upload -- enforced by reading at
# most this many bytes regardless of what the request claims its size is.
MAX_DOCUMENT_UPLOAD_MB=25
# Upper bound on one uploaded PDF's page count, enforced before extracting
# text from any page -- closes a decompression-bomb-shaped gap
# MAX_DOCUMENT_UPLOAD_MB alone doesn't (a PDF's on-disk size says little
# about how many pages it takes to extract).
MAX_DOCUMENT_PAGES=2000

# --- Live web search (see search/web_search.py) ---
# Offers the web_search node to the router. Requires WEB_SEARCH_API_KEY too
# -- both must be set for web search to actually be available.
ENABLE_WEB_SEARCH=false
# Which provider search/web_search.py calls -- see
# search.web_search.SUPPORTED_SEARCH_PROVIDERS for supported values.
# Swapping providers is a config change, not a code change.
WEB_SEARCH_PROVIDER=tavily
# Get a key at https://tavily.com (free tier available) and paste it here.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Max tokens for the LLM call that drafts the web-search answer -- larger
# than a typical answer budget since a good web answer synthesizes several
# sources into a structured, in-depth response (headings, lists, an inline
# citation per claim), not a single short sentence.
WEB_SEARCH_ANSWER_MAX_TOKENS=2400
# Character ceiling on the block of search results handed to that call.
# Whole results are dropped from the lowest-ranked end until the block
# fits, and the omission is stated in the answer -- a result is never cut
# mid-way and a dropped one is never cited. 0 sends every result with no
# budget at all.
#
# Whether this binds at WEB_SEARCH_MAX_RESULTS=5 depends on the sources:
# ordinary web pages come back at roughly 500-2,500 characters each and
# all five fit, while academic/long-form pages can exceed the budget
# between them, in which case the top-ranked ones are used in full and
# the answer says how many were left out. Raise it together with
# OLLAMA_NUM_CTX -- raising only this one moves truncation back inside
# Ollama, where it is silent and eats the system prompt.
WEB_SEARCH_CONTEXT_MAX_CHARS=18000

# --- Enterprise BI integrations (see bi_integration/, api/bi_integration.py) ---
# Governed connectors to Power BI/Looker (push) and Tableau/Excel
# (authenticated file/feed pull). Off by default -- unlike the pure-compute
# analytics engines above, a connector's own refresh makes a real outbound
# HTTP call. Requires a locally-authenticated account either way (no
# feature flag bypasses that).
ENABLE_BI_INTEGRATION=false

# --- REST/OpenAPI connector (rest/) --------------------------------------
# Calls a fixed set of operator-declared, allowlisted HTTPS endpoints
# read-only. Off by default. Enabling the flag WITHOUT naming hosts below
# is inert, not open: an allowlist with no entries permits nothing.
#
# Not routable yet -- there is no sources/descriptors.py entry, so this
# does not appear in GET /sources and the router cannot reach it. See
# docs/architecture/source-connector-contract.md.
ENABLE_REST_CONNECTOR=false

# --- MCP client (mcp_client/) --------------------------------------------
# A client of operator-declared remote MCP servers. Off by default.
#
# WARNING: this is the only production feature here that spawns a
# subprocess. Two controls make that acceptable, both in
# mcp_client/transport.py: the command is an argv list with shell=False
# (nothing you write below is interpreted by a shell), and the child
# receives ONLY the variables named in MCP_<NAME>_ENV -- it does not
# inherit this process's environment, which holds DB_PASSWORD, the JWT
# key and every other secret in this file.
ENABLE_MCP_CLIENT=false

# --- Domain analytics skills (domain_skills/) ----------------------------
# Frames an analysis using a declared skill for the question's business
# domain. Off by default. An accuracy aid only: a domain with no declared
# skill, or an unknown domain, changes nothing.
#
# Skills are in-code constants (domain_skills/catalog.py) and CANNOT be
# added or edited at runtime -- a database row that becomes a system
# prompt would turn every write into prompt injection. Today the Sales,
# MIS, Marketing, HR, eCommerce, Training, Finance, BFSI, Supply Chain,
# Manufacturing, Customer Service, Project, IT Operations, Healthcare,
# Energy, Risk & Audit, Legal, Real Estate and Construction
# prompt-domains have skills; see docs/architecture/domain-skills.md.
# Construction's were derived rather than supplied -- that file says so.
ENABLE_DOMAIN_SKILLS=false


# Per-exchange timeout and response-line cap.
MCP_REQUEST_TIMEOUT_SECONDS=30.0
MCP_MAX_RESPONSE_BYTES=1000000

# Comma-separated server names, each with its own MCP_<NAME>_* block --
# the same convention DB_CONNECTIONS uses. Leave blank for no servers.
# MCP_SERVERS=docs
MCP_SERVERS=

# Per-server settings, for each name listed above. Required: COMMAND and
# PERMISSION (there is no unrestricted remote server; see
# agent/authz.py::Permission for valid values).
# MCP_DOCS_COMMAND=mcp-server-docs
# MCP_DOCS_ARGS=--root,/srv/docs
# MCP_DOCS_PERMISSION=documents_read
#
# Tool names an administrator has approved on this server. OMITTED MEANS
# NONE: the server can be configured and reachable while no tool may be
# called. Matched exactly -- approving `read_file` does not approve
# `read_file_and_delete`. A tool the server offers that is not listed
# here is shown by discovery and refused on call.
# MCP_DOCS_ALLOWED_TOOLS=search_docs,get_doc
#
# The complete environment for the subprocess, as KEY=VALUE pairs. The
# child gets exactly these and nothing else.
# MCP_DOCS_ENV=HOME=/tmp,PATH=/usr/bin


# Hostnames the connector may call, comma-separated. Matched EXACTLY and
# case-insensitively, never as a suffix -- an `example.com` entry does not
# permit `evil-example.com` or `example.com.evil.net`. Every URL is also
# re-checked on every use, and every redirect hop re-validated, against
# the private/loopback/link-local/reserved address blocklist (see
# security/outbound_url.py). Empty refuses everything.
# REST_ALLOWED_HOSTS=api.example.com,data.example.org
REST_ALLOWED_HOSTS=

# Per-request timeout, seconds.
REST_TIMEOUT_SECONDS=10.0

# Hard cap on bytes read from one response, enforced against a declared
# Content-Length before any body is read AND against bytes actually
# received (a response can omit or lie about that header).
REST_MAX_RESPONSE_BYTES=2000000

# Redirect hops a call may follow. Each hop is itself a fresh SSRF check,
# so an unbounded chain would mean unbounded validation work. 0 = none.
REST_MAX_REDIRECTS=3

# Power BI's push-dataset REST API base URL + API key -- organization-wide,
# set once here (never per-tenant-dynamic; see config.settings.Settings
# .power_bi_push_base_url's own docstring for why). Leave both blank to
# keep Power BI connectors unavailable even with the flag above enabled --
# a Power BI connector then fails closed at refresh time with a clear
# error, never a silent no-op. A Looker connector's own webhook URL is
# supplied per-connector instead (via POST /bi/connectors), not here.
POWER_BI_PUSH_BASE_URL=
POWER_BI_PUSH_API_KEY=
BI_OUTBOUND_REQUEST_TIMEOUT_SECONDS=10.0
BI_EXPORT_MAX_ROWS=5000
BI_EXPORT_CACHE_MAX_ENTRIES=200

# --- IMA Studio media generation (image/video/audio) ---
# media_gen/, rate limiting, and orchestrator wiring (routed as the
# "generation" source, see agent/orchestrator/nodes.py::generation_node)
# are built, tested, and confirmed working end-to-end against a real IMA
# account (text-to-image generation, download, and serving via
# GET /media/{media_id} all verified with a live call). Video generation
# shares the same client/task-creation code path but hasn't been
# separately confirmed live yet. Get a key at https://imastudio.com
# (dashboard), then set ENABLE_MEDIA_GENERATION=true below to enable --
# left off by default so a fresh clone never spends real IMA credits
# without the operator deliberately opting in.
ENABLE_MEDIA_GENERATION=false
IMA_API_KEY=
IMA_API_BASE_URL=https://api.imastudio.com
# Deliberately tighter than a text-query limit -- generation costs
# meaningfully more per call than a text LLM turn.
MEDIA_GEN_RATE_LIMIT=5
MEDIA_GEN_RATE_WINDOW_SECONDS=60
# Overrides the video model's own default clip length. NOT a "make videos
# any length" knob -- verified live against a real account: the
# auto-selected model ("Seedance 2.0") only accepts an integer 4-15
# (its own declared min/max), default 5. No current IMA video model
# supports a single multi-minute generation -- a real model-capability
# ceiling. Leave unset to use the model's own default; an out-of-range
# value is rejected by IMA itself as a clean provider failure.
MEDIA_GEN_VIDEO_DURATION_SECONDS=
# Generation is a real, metered third-party API call -- the only source in
# the orchestrator that spends money -- so it requires an explicit human
# confirmation (POST /generate/confirm) before IMA is actually called, the
# same way the SQL pipeline's "Confirm and Run" gates query execution.
# Secure by default; set false only for a trusted automation context that
# has already reviewed this tradeoff.
REQUIRE_GENERATION_APPROVAL=true
# Max combined generation+web source invocations allowed per session within
# the window below -- a session-level cost ceiling, since a single question
# can already trigger both at once and nothing previously capped how many
# times one session could keep doing that. Not a substitute for real
# per-user auth (session_id is a correlation token, not an identity).
SESSION_EXPENSIVE_SOURCE_LIMIT=10
SESSION_EXPENSIVE_SOURCE_WINDOW_SECONDS=3600

# --- Latency budgets (measured; see docs/PERFORMANCE.md) ---
# Context measured on the reference machine 2026-10-22: ~96-99% of a
# question's wall-clock is LLM inference, because the configured 7B model
# loads only 41% into a 4GB GPU and runs the rest on CPU -- ~185 tok/s
# prompt processing, ~9.6 tok/s generation. Database execution measured
# 0.05s. Latency is therefore
#     prompt_tokens / 185 + generated_tokens / 9.6
# per model call, so the levers are HOW MANY calls a question makes and
# HOW BIG each prompt is. Nothing in this section changes that ceiling --
# the model fitting in VRAM does. See docs/PERFORMANCE.md section 6.
#
# What a first useful response is aimed at. Advisory: it is what
# docs/PERFORMANCE.md reports against, NOT a deadline that cancels work.
# Cutting a correct answer off at N seconds trades accuracy for a number.
TARGET_FIRST_RESPONSE_SECONDS=5
# Skip the analytical-intent model call for a question showing no
# complexity signal. Measured 12-25s per question for a classification
# whose only consumer is the query planner's gate -- and that gate, per
# the node's own contract, reduces to exactly the complexity signals when
# the intent is None. So a simple question paid a full model call for a
# result that changed nothing. Measured effect: 3 model calls -> 2, and
# 123.77s -> 80.08s on the same question.
# Set false to restore the previous always-classify behaviour.
SKIP_INTENT_CLASSIFICATION_FOR_SIMPLE_QUESTIONS=true
# Hard ceiling on tables rendered into the generation prompt. Schema
# measured 2,968 of the 6,632 prompt tokens (7 tables), which is more
# than SCHEMA_TOP_K implies because relationship expansion adds tables.
# Each table removed is roughly 2 seconds.
#
# 0 (the default) disables the ceiling. Off by default deliberately:
# dropping a table the question genuinely needs turns a slow correct
# answer into a fast wrong one, so opt in once you know your schema fits.
MAX_SCHEMA_TABLES_IN_PROMPT=0
# Worth knowing: ENABLE_RESULT_CACHE is off by default and makes a
# repeated question free. SCHEMA_TOP_K is the other high-value dial.
# Keep OLLAMA_NUM_CTX the same across callers -- a changed num_ctx forces
# Ollama to reload the model (measured 5.7s -> 13-14s for one call).

# --- Readable business names (db/display_names.py, agent/display_name_guard.py) ---
# Stops a result being labelled by a raw key: "total sales by product"
# returns a product NAME, not a ProductKey.
#
# How it works: after SQL generation and before validation, if the query
# labels rows by a surrogate key that a DECLARED foreign key connects to a
# dimension with a readable column, the join is added and the key swapped
# for the name. Repaired SQL still passes through the SELECT-only
# validator, so this can never widen what a query is allowed to do.
#
# It never guesses a join. Where the relationship is not declared in the
# schema, the finding becomes retry feedback for the next generation
# attempt instead (sharing the one MAX_RETRIES budget). Where the
# dimension has no readable column at all, the key is kept and the
# limitation is disclosed rather than a label invented.
#
# Set false to restore the previous behaviour exactly: the node becomes a
# pass-through and only the generation prompt's advisory rule applies.
# See docs/DISPLAY_NAMES.md.
ENABLE_DISPLAY_NAME_ENFORCEMENT=true
# Which column holds each entity's readable name is derived from live
# schema introspection and needs no configuration. Override a specific
# table in config/display_names.yaml when inference would pick wrong --
# that file ships as an empty template and documents the format.

# --- Deterministic source routing (agent/orchestrator/source_signals.py) ---
# A deterministic signal pre-pass in front of the LLM source classifier.
# On by default, and additive: an *ambiguous* question still goes to the
# classifier exactly as before. What changes is the unambiguous case --
# "extract the text from this image" no longer costs a classification
# call and no longer depends on the configured model following a prompt.
# Set false to restore the pre-existing path exactly (no scoring, no
# confidence reported, classification for every multi-source question).
SOURCE_ROUTING_ENABLED=true
# Confidence at or above which the deterministic pick is trusted and the
# classification call is skipped. Deliberately high: a wrong skip routes
# a question with no model to catch it, while a wrong non-skip costs one
# LLM call. A question whose runner-up source scores close to the leader
# is treated as ambiguous and goes to the classifier regardless.
SOURCE_CONFIDENCE_THRESHOLD=0.70
# Which sources this deployment routes to is NOT configured here -- it is
# derived from each source's own feature flag plus the config that source
# actually needs (sources/descriptors.py is the single owner). The brief's
# ENABLED_SOURCES is therefore these existing flags, not a second list
# that could disagree with them:
#   database  -> always available (DB_* / DB_CONNECTIONS)
#   documents -> ENABLE_DOCUMENT_RAG + RAG_STORE_CONNECTION_STRING
#   policies  -> ENABLE_POLICY_RAG   + RAG_STORE_CONNECTION_STRING
#   web       -> ENABLE_WEB_SEARCH   + WEB_SEARCH_API_KEY
#   files     -> ENABLE_CHAT_ATTACHMENTS (per-request, not standing config)
#   media     -> ENABLE_MEDIA_SEARCH / ENABLE_MEDIA_GENERATION + IMA_API_KEY
# A flag alone with nothing configured behind it does not make a source
# available, since routing to it would simply fail.
# Hard ceiling on retrieved chunks carried into a RAG answer prompt,
# across every retrieval source -- bounds context amplification
# independently of each store's own top-k.
MAX_RETRIEVAL_CHUNKS=10

# --- Guardrails (guardrails/) ---
# These tune the ADVISORY safety layers: injection detection, abuse
# screening, PII redaction of free text, and grounding.
#
# They CANNOT soften a fail-closed control. With GUARDRAILS_ENABLED=false
# and GUARDRAIL_ACTION=warn both set, the SQL validator still rejects a
# non-SELECT, RBAC still denies an unauthorized source, CREDENTIAL and
# PAYMENT columns are still withheld from everyone (including admins),
# tenant resolution still fails closed, and a sensitivity-categorised
# policy chunk is still never summarised. See guardrails/__init__.py and
# tests/test_guardrails.py, which proves that for every fail-closed layer.
GUARDRAILS_ENABLED=true
# What an advisory layer does when it fires: block | warn | redact.
# "warn" answers anyway with a notice attached, which is useful while
# tuning a detector. Never consulted for a fail-closed layer.
GUARDRAIL_ACTION=block
# Prompt-injection and jailbreak detection, on the question and on
# retrieved/supplied content alike. DETECTION, not the boundary --
# agent/sql_validator.py and the RBAC gates bound the consequences, which
# is why turning this off creates no escalation path.
PROMPT_INJECTION_PROTECTION=true
# Redaction of secret-shaped and personal data in free text. Result
# *columns* are governed separately and unconditionally by
# ENABLE_RESULT_GOVERNANCE, which this does not affect.
PII_REDACTION_ENABLED=true
# Narrow abuse screening over question text. Deliberately not a content
# classifier -- moderation/gate.py is the real content gate for ingested
# assets. Kept narrow because over-blocking ordinary analytics ("accounts
# at risk of default", "employee attrition") is its own failure mode.
TOXICITY_CHECK_ENABLED=true

# --- Hallucination and grounding controls (guardrails/grounding.py) ---
# Whether grounding is assessed at all. With this on and
# SOURCE_GROUNDING_REQUIRED off, a weakly-grounded answer is still
# returned but labelled, rather than suppressed.
HALLUCINATION_CHECK_ENABLED=true
# Whether a retrieval-backed answer that fails the grounding check is
# replaced with "I could not verify this". On by default: an unverifiable
# answer presented as an answer is what discredits every other answer.
# Note this is a check of *necessary conditions* (evidence exists, is
# cited, the citations are real, the answer overlaps its evidence) -- it
# is not a truth oracle, and the response says "could not verify", never
# "that is false".
SOURCE_GROUNDING_REQUIRED=true
# Whether a model-proposed tool call that deterministic validation
# rejects is refused. Note this is NOT the enforcement: the tool registry
# and agent/sql_validator.py refuse an invalid call regardless, so this
# cannot be used to permit one.
BLOCK_UNSAFE_TOOL_CALLS=true
# Retrieval confidence floor for treating a source's answer as grounded.
MIN_SOURCE_CONFIDENCE=0.70
# Whether a retrieval-backed answer must carry at least one citation.
REQUIRE_CITATIONS=true
# Whether the model may answer from its own parametric knowledge when
# retrieval found nothing. False is the conservative default for a
# platform whose purpose is answering from *this* deployment's data.
ALLOW_GENERAL_KNOWLEDGE=false

# --- AI-guided (generative) image editing, chat attachments (2026-09-27) ---
# Real, prompt-driven editing of an attached image ("Remove the selected
# object," "Replace the sky," ...) from the Edit-image modal's AI-guided
# panel -- attachments/ai_edit.py + media_gen/image_edit_provider.py,
# reusing the same IMA_API_KEY configured above (IMA Studio's
# image_to_image task category; verified live to have no native mask
# parameter -- a painted mask is conveyed as a translucent visual overlay
# plus a text instruction, disclosed to the user, never presented as
# pixel-exact masking). Requires ENABLE_MEDIA_GENERATION's own IMA_API_KEY
# to be set -- this flag only gates whether the ai-edit *route* is willing
# to use it. Off by default for the same reason media generation is: no
# real-money provider call should ever run without the operator
# deliberately opting in. Local editing (crop/rotate/draw), OCR, resize,
# and deterministic blur are completely unaffected by this flag either way.
ENABLE_IMAGE_EDITING=false
# One provider poll's own timeout -- not the whole request end-to-end (the
# upload and result-download legs are bounded separately by their own
# HTTP client timeouts).
IMAGE_EDIT_TIMEOUT_SECONDS=90
IMAGE_EDIT_POLL_INTERVAL_SECONDS=3
IMAGE_EDIT_MAX_PROMPT_LENGTH=500

# --- Voice mode (see voice/) -- local STT/TTS, no cloud API, same "fully
# local" posture as Ollama. On by default (unlike media generation, this
# costs nothing and calls no external API once its one-time local model
# downloads are done). When on, the React dashboard shows a mic button and
# its own settings toggle (GET /health's voice_enabled field is how the
# frontend knows to). A transcribed question is still plain untrusted
# text -- it goes through the exact same POST /ask path (and
# agent.input_guard.check_input) a typed question does. ---
ENABLE_VOICE_MODE=true
# faster-whisper model size (tiny/base/small/medium/large-v3) -- auto-
# downloaded from Hugging Face Hub on first use, cached locally after that.
STT_MODEL_SIZE=base
# cpu or cuda. Defaults to cpu -- nothing in this project's Docker setup
# assumes a GPU; only set cuda on a machine with a confirmed working
# CUDA + cuDNN setup.
STT_DEVICE=cpu
# Caps the schema-derived vocabulary hint fed to Whisper's initial_prompt
# (table/column names, so real schema terms are less likely to be
# misheard) -- short by design, not a full schema dump.
STT_VOCABULARY_MAX_CHARS=200
# Runs the raw Whisper transcript through one extra local Ollama call to fix
# misheard words, strip filler words/false starts, resolve self-corrections,
# and normalize punctuation before it's returned. On by default -- costs no
# money (local Ollama), fails open to the raw transcript on any error.
ENABLE_VOICE_CORRECTION=true
VOICE_CORRECTION_MAX_TOKENS=150
# Max size/duration of one recorded question, enforced before transcription
# (the same read-and-reject-if-over pattern as document uploads).
VOICE_MAX_UPLOAD_MB=10
VOICE_MAX_DURATION_SECONDS=30
# Piper voice model name -- download it once with:
#   python scripts/download_voice_model.py
TTS_VOICE=en_US-lessac-medium
# Override for where the Piper .onnx/.onnx.json pair lives, if not the
# default voice/models/<TTS_VOICE>.onnx.
TTS_VOICE_MODEL_PATH=

# --- Media search (optional, off by default -- see media/) ---
# Search an UNTAGGED local image/video library by plain-English content
# description (routed as the "media_search" orchestrator source -- see
# agent/orchestrator/nodes.py::media_search_node). Unlike every other
# optional source, the default embedding provider (local CLIP, via
# sentence-transformers) needs no API key and sends nothing to a third
# party -- but it does pull in torch and opencv-python, a real, larger
# dependency footprint than this project's other optional features, which
# is why this stays off by default. Both ENABLE_MEDIA_SEARCH=true and a
# real MEDIA_LIBRARY_PATH are required before this source becomes
# available (an enabled flag with no folder configured is not "available").
# After setting both, run: python scripts/build_media_index.py
ENABLE_MEDIA_SEARCH=true
MEDIA_LIBRARY_PATH=./media_library
# Only "local_clip" (on-device, no API key) is implemented today -- see
# media/embedding.py.
MEDIA_EMBEDDING_PROVIDER=local_clip
MEDIA_CLIP_MODEL_NAME=clip-ViT-B-32
# An Ollama vision-capable model name for per-video-segment captioning
# AND for chat image attachments (see attachments/vision.py -- "describe
# this image"/"extract image text" chat questions need this set, or they
# fail closed with an honest "vision unavailable" answer, never a silent
# false claim of having looked at the image). Blank (default) skips both:
# video segments are still indexed/searchable via ASR+OCR text alone, and
# an attached image falls back to on-screen-text OCR only (needs the
# system Tesseract binary -- see ENABLE_MEDIA_SEARCH's own OCR note below).
#
# Not every locally pulled model can see images -- check with
# `ollama list` and look for "vision" in that model's own `ollama show
# <model>` capabilities output before setting this, or the app will send
# an image to a text-only model and get a text-only (non-image-aware)
# answer back with no error. e.g. "llava" is a small, purpose-built vision
# model (pull with: ollama pull llava); a general large model may also
# already support vision (e.g. "qwen3.8:27b", "llama3.2-vision") if you
# have it pulled -- reuse it here instead of pulling a second model.
MEDIA_VISION_MODEL=
MEDIA_MAX_FILE_MB=200
MEDIA_SEARCH_TOP_K=5
# PySceneDetect's ContentDetector sensitivity -- lower detects more
# (subtler) scene changes, producing more video segments. 27.0 is
# PySceneDetect's own documented default.
MEDIA_SCENE_DETECT_THRESHOLD=27.0
# POST /search/media reuses the existing shared API_ACTION_RATE_LIMIT_PER_MINUTE
# (see below) rather than a dedicated limiter -- a query is cheap and
# orchestrator-routed questions are already bounded by /ask's own limiter.

# --- Chat attachments (images/PDF/DOCX/XLSX/PPTX/TXT/CSV/JSON) ---
# On by default -- no cost, no outbound network call (image description
# reuses the local MEDIA_VISION_MODEL above, same as media captioning).
# Works even with ENABLE_MULTI_SOURCE_ROUTER=false; attaching a file is a
# per-request opt-in, not a standing routing decision. Set
# MEDIA_VISION_MODEL (above) to a vision-capable model (e.g. llava) so an
# attached image actually gets described -- without it, images are still
# stored and shown in the UI but the model can't see their content, only
# text/document attachments will be usable.
ENABLE_CHAT_ATTACHMENTS=true
MAX_ATTACHMENT_IMAGE_BYTES=10485760
MAX_ATTACHMENT_DOCUMENT_BYTES=26214400
MAX_ATTACHMENTS_PER_MESSAGE=5
MAX_TOTAL_ATTACHMENT_BYTES=52428800
MAX_ATTACHMENT_TEXT_CHARS=80000
MAX_ATTACHMENT_DOCUMENT_PAGES=200
MAX_ATTACHMENT_SPREADSHEET_ROWS=500
MAX_ATTACHMENT_IMAGE_DIMENSION_PX=1568
ATTACHMENT_STORAGE_DIR=./data/attachments
ATTACHMENT_RETENTION_HOURS=24
# Explicit image actions (POST /attachments/{id}/resize|extract-text|
# detect-text-regions|remove-text -- see attachments/image_ops.py,
# attachments/ocr_extract.py, attachments/inpaint.py). Resize and text
# removal need no extra config (Pillow/OpenCV, already required deps);
# extract-text/remove-text's auto-detect step need the system Tesseract
# binary installed separately, same as MEDIA_VISION_MODEL's OCR fallback
# above and ENABLE_MEDIA_SEARCH's own OCR step.
MAX_ATTACHMENT_RESIZE_DIMENSION_PX=4096
ATTACHMENT_OCR_TIMEOUT_SECONDS=20.0
MAX_TEXT_REMOVAL_REGIONS=20
# Decompression-bomb guard for ZIP-container documents (DOCX/XLSX/PPTX are
# all plain ZIP archives) -- checked against the archive's own central-
# directory metadata before python-docx/openpyxl/python-pptx ever
# decompresses a single entry (attachments/zip_safety.py). Independent of
# MAX_ATTACHMENT_DOCUMENT_BYTES above, which only bounds the *compressed*
# upload size.
MAX_ATTACHMENT_ZIP_UNCOMPRESSED_BYTES=209715200
MAX_ATTACHMENT_ZIP_ENTRIES=2000
# Hard wall-clock bound on one attachment's processor call
# (attachments/pipeline.py::process_attachment) -- a pathological file
# (e.g. a PDF with a deeply nested object graph) can't tie up a request
# thread past this, enforced via a bounded background-thread pool. Same
# "the calling thread stops waiting; Python can't force-kill another
# thread" caveat api/main.py's own /ask timeout already has.
ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=30.0

# --- Profile pictures (identity/profile_picture.py) -- the signed-in
# user's own avatar, set from the Account section of the settings dialog
# (POST/GET/DELETE /auth/me/avatar). Needs LOCAL_AUTH_ENABLED: an avatar
# hangs off an identity.users row, so an OIDC or unauthenticated caller
# has nowhere to store one.
#
# Accepted formats are NOT configurable -- JPG, PNG and WebP, checked by
# extension and by magic bytes. The stored image is always one WebP square.
#
# Tighter than MAX_ATTACHMENT_IMAGE_BYTES on purpose: an avatar lives on
# the account row indefinitely and is only ever shown at 32px.
PROFILE_PICTURE_MAX_BYTES=5242880
# Edge of the stored square, in pixels.
PROFILE_PICTURE_SIZE_PX=256
# Whether a vision model checks the photo is clear and appropriately
# framed before it is stored. Needs MEDIA_VISION_MODEL set; with no vision
# model there is nothing to check with and the upload proceeds with that
# disclosed (the check is a quality aid and fails open -- the size, type,
# signature and malware gates all still refuse).
PROFILE_PICTURE_VISION_CHECK_ENABLED=true
# Budget for that one call, well under OLLAMA_REQUEST_TIMEOUT_SECONDS
# because somebody is waiting on an upload dialog.
#
# Measured 2026-10-22 on the reference machine (T1200, 4GB) with
# qwen3.8:27b: 36.2s warm, with a correct verdict -- but OVER 60s cold,
# which a real upload hit. `ollama ps` shows why: 18GB running 98% on CPU,
# with Ollama's default 5-minute keep-alive, so the first upload after a
# few idle minutes pays a full model load first. 120 covers both; a warm
# check still returns in ~36s.
#
# A smaller vision model is the better fix: llava (4.7GB) fits the GPU.
# Lower this to match if you switch MEDIA_VISION_MODEL.
PROFILE_PICTURE_VISION_TIMEOUT_SECONDS=120.0

# --- Malware scanning (security/malware_scanner.py) -- binary-signature
# scan of an upload's raw bytes, before any parser (pypdf/pymupdf/Pillow/
# python-docx/openpyxl/python-pptx) ever touches them. Runs for chat
# attachments (attachments/pipeline.py), document/policy RAG PDF uploads
# (rag/ingestion.py), and media-library ingestion (media/ingest.py) alike.
#
# Off by default -- no scanning capability existed in this codebase before
# it was added, so defaulting it "on" would break every existing
# deployment without a ClamAV daemon reachable. Once enabled, an infected
# result AND a scanner error/timeout/unreachable-daemon are both treated as
# a rejection -- "unknown" is never silently treated as "clean." A
# production deployment (ENVIRONMENT=production below) with chat
# attachments, document RAG, policy RAG, or media search enabled MUST set
# this to "clamav" -- Settings refuses to start otherwise (see
# config/settings.py::_require_malware_scanning_in_production).
MALWARE_SCAN_PROVIDER=disabled
# Only read when MALWARE_SCAN_PROVIDER=clamav -- clamd's own INSTREAM wire
# protocol is spoken directly over a plain socket, no vendor SDK.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=15.0

# --- Content moderation gate (mandatory, not optional -- see moderation/) ---
# Runs before anything is embedded/stored by EITHER media search
# (ENABLE_MEDIA_SEARCH) or document/policy RAG (ENABLE_DOCUMENT_RAG/
# ENABLE_POLICY_RAG) -- there is deliberately no flag to turn this off
# while leaving either of those on. Ingestion for either pipeline fails
# closed with a clear error if the settings below aren't set.
#
# Only "azure_content_safety" is implemented today. Azure's real harm
# categories are Hate/SelfHarm/Sexual/Violence -- there is no dedicated
# "weapons"/"drugs"/"synthetic media" category; see
# moderation/taxonomy.py's module docstring for how those are covered
# instead (a text blocklist, and a disclosed placeholder, respectively).
MODERATION_PROVIDER=azure_content_safety
# Your Content Safety resource's endpoint, e.g.
# https://<resource-name>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Minimum severity (0/2/4/6 on Azure's standard four-level scale) that
# triggers a hard-reject for the Hate/SelfHarm/Sexual/Violence categories.
# Verify this against your specific Content Safety API version.
MODERATION_SEVERITY_THRESHOLD=4
# Override for the weapons/drugs text-term blocklist YAML. Blank (default)
# uses config/moderation_blocklist.yaml.
MODERATION_BLOCKLIST_PATH=
#
# Dedicated SQL Server connection for moderation decisions/dedupe metadata
# (moderation/store.py's moderation.media_assets table) -- deliberately
# separate from both DB_CONNECTIONS and RAG_STORE_CONNECTION_STRING (see
# Settings.moderation_store_connection_string's docstring for why). Point
# this at the same physical database as RAG_STORE_CONNECTION_STRING if you
# want one shared metadata store -- that's your choice, not a requirement.
MODERATION_STORE_CONNECTION_STRING=
MODERATION_STORE_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# QueuePool sizing -- explicit here (unlike DB_CONNECTIONS/
# RAG_STORE_CONNECTION_STRING, which both rely on SQLAlchemy's defaults of
# 5/10) because ingestion can run many concurrent DB writes. Size against
# MEDIA_INGEST_WORKERS below plus normal concurrent PDF-upload traffic.
MODERATION_STORE_POOL_SIZE=10
MODERATION_STORE_MAX_OVERFLOW=20
# Below whatever idle-connection timeout your SQL Server instance/network
# enforces -- 1800s matches what DB_CONNECTIONS/RAG_STORE_CONNECTION_STRING
# both hardcode.
MODERATION_STORE_POOL_RECYCLE_SECONDS=1800
# Concurrent worker threads scripts/build_media_index.py uses to ingest
# files (moderation + embedding + DB writes per file) -- this project's
# first use of a bounded thread pool; previously a sequential loop.
MEDIA_INGEST_WORKERS=4
# An ingested image wider or taller than this (pixels) is split into a
# tile grid before moderation, so a classifier's own downsampling can't
# shrink away a small region of concern in a very large image.
MEDIA_IMAGE_TILE_THRESHOLD_PX=2048

# --- Docker Compose port binding (docker-compose.yml only -- NOT read by
# the Python app itself, purely Compose ${VAR} substitution) ---
# Localhost-only by default: an unqualified "8000:8000" mapping binds every
# host interface. Only widen this (e.g. to 0.0.0.0) once a real
# authenticating reverse proxy is in front -- see docs/DEPLOYMENT.md's
# "Reverse proxy and auth" section.
API_BIND_HOST=127.0.0.1

# AI Data Analyst agent (Prompt 33, 33_AI_DATA_ANALYST_AGENT_CONTRACT.md).
# Off by default. POST /analyst/investigate returns 404 while this is false.
# Every limit below is a hard server-side stop rule; a request cannot raise one.
#ENABLE_DATA_ANALYST_AGENT=false
#ANALYST_MAX_STEPS=12
#ANALYST_MAX_SUBQUERIES=4
#ANALYST_MAX_LLM_CALLS=2
#ANALYST_MAX_FOLLOWUPS=2
#ANALYST_TIMEOUT_SECONDS=180
#ANALYST_MAX_RECOMMENDATIONS=10

# Multi-agent supervisor (Prompt 34, POST /analyst/supervise). Off by default.
#ENABLE_MULTI_AGENT_SUPERVISOR=false
#MULTIAGENT_MAX_AGENT_CALLS=16
#MULTIAGENT_MAX_COST_UNITS=40
#MULTIAGENT_CIRCUIT_FAILURE_THRESHOLD=3
#MULTIAGENT_CIRCUIT_COOLDOWN_SECONDS=60

# Semantic intelligence (Prompt 35, 35_SEMANTIC_INTELLIGENCE_CONTRACT.md). Off by default.
#ENABLE_SEMANTIC_INTELLIGENCE=false

# --- Intent-based source routing (see docs/ROUTING.md) ---
# Fan every unselected question out to every retrieval source. Default
# false: with it on, "Sick leave policy" also ran the SQL pipeline, which
# cost 30s and produced a refusal rendered above the real answer.
ROUTE_TO_ALL_SOURCES=false
# Which model classifies the question. Blank uses OLLAMA_MODEL.
ROUTER_MODEL=
# Cap on the routing reply (the JSON contract plus headroom).
ROUTER_MAX_TOKENS=400
# Budget for the routing call. Past this the deterministic keyword
# fallback decides instead -- measured 31-40s for the LLM router on a
# 4GB GPU, so on that hardware the fallback is what routes.
ROUTER_TIMEOUT_SECONDS=5.0
# Render failed/errored pipeline stages in the UI. Off by default: these
# are a developer view and were being shown to normal users above real
# answers. They stay in the logs regardless.
SHOW_PIPELINE_DEBUG=false
